#!/usr/bin/env bash
# SDLC kit pre-commit guard.
#
# Refuses commits that carry secrets or key material. This lives in git rather
# than in an agent's hook system on purpose: it binds every agent and every
# human, and it keeps working when someone switches tools or edits by hand.
#
# Install:
#   cp templates/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or, to version it with the repo:
#   git config core.hooksPath .githooks && cp templates/git-hooks/pre-commit .githooks/
#
# Bypass (deliberately awkward, and it should be): git commit --no-verify

set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0
say() { printf '%s\n' "$*" >&2; }

# --- 1. files that must never be committed ---------------------------------

blocked=$(printf '%s\n' "$staged" | grep -Ei \
  -e '(^|/)\.env$' \
  -e '(^|/)\.env\.(local|development|production|staging|test)$' \
  -e '(^|/)id_(rsa|dsa|ecdsa|ed25519)$' \
  -e '\.(pem|key|p12|pfx|keystore|jks)$' \
  -e '(^|/)\.netrc$' \
  -e '(^|/)(credentials|secrets?)\.(json|ya?ml|toml|ini)$' \
  -e '(^|/)(service-account|gcp-key)[^/]*\.json$' \
  -e '(^|/)\.(aws|ssh|gnupg)/' \
  || true)

if [ -n "$blocked" ]; then
  say ""
  say "pre-commit: these files must never be committed:"
  printf '  %s\n' $blocked >&2
  say ""
  say "  .env files belong in .gitignore; commit .env.example with placeholders."
  say "  If one of these was already pushed, treat the secret as compromised:"
  say "  rotate it first, then clean history."
  fail=1
fi

# --- 2. high-confidence secret patterns in the staged content --------------
#
# Deliberately narrow. A guard that fires on ordinary code gets bypassed, and
# a bypassed guard protects nothing. These patterns are unambiguous.

patterns=(
  'AKIA[0-9A-Z]{16}'                                  # AWS access key id
  'ghp_[A-Za-z0-9]{36}'                               # GitHub personal token
  'gho_[A-Za-z0-9]{36}'                               # GitHub OAuth token
  'github_pat_[A-Za-z0-9_]{50,}'                      # GitHub fine-grained PAT
  'sk-[A-Za-z0-9]{32,}'                               # OpenAI-style key
  'sk-ant-[A-Za-z0-9-]{32,}'                          # Anthropic key
  'xox[baprs]-[A-Za-z0-9-]{10,}'                      # Slack token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'                # any private key block
  'AIza[0-9A-Za-z_-]{35}'                             # Google API key
)

for file in $staged; do
  # Skip this hook and the kit's own documentation of these patterns.
  case "$file" in
    *pre-commit|*threat-prompts.md|*secure-coding/SKILL.md) continue ;;
  esac
  [ -f "$file" ] || continue

  for p in "${patterns[@]}"; do
    # -e matters: several patterns start with a dash and would otherwise be
    # parsed as grep options.
    if git show ":$file" 2>/dev/null | grep -Eq -e "$p"; then
      say ""
      say "pre-commit: $file contains something shaped like a credential (/$p/)."
      say "  Remove it and read the value from the environment instead."
      fail=1
    fi
  done
done

# --- 3. merge conflict markers ---------------------------------------------

for file in $staged; do
  [ -f "$file" ] || continue
  if git show ":$file" 2>/dev/null | grep -Eq '^(<<<<<<< |>>>>>>> )'; then
    say ""
    say "pre-commit: $file still has merge conflict markers."
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  say ""
  say "Commit refused. Fix the above, or bypass with --no-verify if you are certain."
  exit 1
fi

exit 0
